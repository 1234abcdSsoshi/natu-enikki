# このファイルを .env という名前でコピーし、あなたのAPIキーを入れてください。
# .env はGitなどでコミットしないでください（.gitignore で除外済み）。

# Gemini APIキー（絵を描く機能・Geminiエンジンに使用）
# https://aistudio.google.com/apikey で発行できます。
GEMINI_API_KEY=

# Supabase（日記の保存・ログイン機能に使用）
# https://supabase.com/ で無料プロジェクトを作成し、
# Project Settings > API から Project URL と anon public キーを入れてください。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
